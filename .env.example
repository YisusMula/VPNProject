# ============================================================================
# VPNProject – variables de configuración
# ============================================================================
# NO hace falta que copies este fichero a mano.
#
#     ./deploy.sh
#
# genera el .env solo, autodetectando todo lo que puede leer de tu red.
# Este ejemplo está aquí como referencia de qué se puede ajustar después.
#
# Si editas .env, vuelve a ejecutar ./deploy.sh para aplicar los cambios.
# ============================================================================

# ---- Punto de conexión ------------------------------------------------------
# Dominio o IP pública que usarán tus dispositivos para encontrar el servidor.
# Autodetectado: la IP pública actual, o tu dominio DDNS si lo configuras.
#
# Con IP dinámica, pon aquí un dominio DDNS. Si dejas una IP literal, tus
# dispositivos dejarán de conectar en cuanto la operadora te la cambie.
WG_HOST=tu-dominio.duckdns.org

# Puerto UDP del túnel. Es el ÚNICO que hay que reenviar en los routers.
WG_PORT=51820

# Avanzado: puerto que se escribe en las configuraciones de cliente, si es
# distinto del que escucha el servidor. Úsalo si tu operadora bloquea el 51820
# y tienes que reenviar un puerto externo distinto:
#   router: UDP 12345 (externo) -> 51820 (interno)  =>  WG_CONFIG_PORT=12345
# Si lo dejas vacío, se usa WG_PORT.
# WG_CONFIG_PORT=

# ---- Panel de administración ------------------------------------------------
# Dirección en la que escucha el panel web.
# Autodetectado: la IP de este servidor en tu red local, de modo que puedas
# entrar desde cualquier equipo de casa pero nunca desde internet.
# Pon 127.0.0.1 si prefieres que sólo se acceda por un túnel SSH.
WG_UI_BIND=192.168.1.50

# Contraseña del panel, en claro. La generó deploy.sh si no pusiste ninguna.
# Los scripts la necesitan para hablar con la API del panel.
WG_EASY_PASSWORD=cambiala-por-una-tuya

# Hash bcrypt de la contraseña anterior: es lo que consume el contenedor,
# que rechaza contraseñas en claro. Lo calcula deploy.sh.
# LAS COMILLAS SIMPLES SON OBLIGATORIAS: sin ellas docker compose interpreta
# los '$' del hash y el panel acaba con una contraseña que no es la tuya.
PASSWORD_HASH='$2a$12$ejemplo.de.hash.bcrypt.no.uses.este.valor.literal'

# Control interno: contraseña con la que se calculó el hash de arriba.
# deploy.sh lo usa para saber si tiene que recalcularlo.
WG_EASY_PASSWORD_HASHED_FROM=cambiala-por-una-tuya

# ---- Red del túnel ----------------------------------------------------------
# DNS que usarán los dispositivos conectados. Viaja por dentro del túnel,
# así que no hay fugas de DNS que delaten dónde estás realmente.
# Si quieres resolver nombres de tu red local, pon aquí la IP de tu router.
WG_DEFAULT_DNS=1.1.1.1,8.8.8.8

# Rango de direcciones del túnel. El servidor ocupa siempre el .1
WG_DEFAULT_ADDRESS=10.8.0.x

# ---- DDNS (opcional, recomendado con IP dinámica) ---------------------------
# Crea un dominio gratis en https://www.duckdns.org y pega aquí el subdominio
# (sin ".duckdns.org") y el token. deploy.sh levantará un contenedor que
# mantiene el registro apuntando a tu IP actual, también tras reiniciar.
#
# ¿Usas otro proveedor DDNS? Deja estos dos vacíos, pon tu dominio en WG_HOST
# y encárgate tú de mantener el registro.
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# Zona horaria del contenedor de DDNS, sólo para que sus registros cuadren.
TZ=Europe/Madrid
